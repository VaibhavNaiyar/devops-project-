# Ubuntu 24.04 LTS (Canonical) for every server
data "aws_ami" "ubuntu" {
  most_recent = true
  owners      = ["099720109477"]
  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*"]
  }
}

# SSH key generated by Terraform; private key saved only on the admin machine (~/.ssh)
resource "tls_private_key" "ssh" {
  algorithm = "ED25519"
}

resource "aws_key_pair" "main" {
  key_name   = "${var.project}-key"
  public_key = tls_private_key.ssh.public_key_openssh
}

resource "local_sensitive_file" "ssh_private_key" {
  filename        = pathexpand("~/.ssh/${var.project}.pem")
  content         = tls_private_key.ssh.private_key_openssh
  file_permission = "0600"
}

resource "aws_instance" "jenkins" {
  ami                    = data.aws_ami.ubuntu.id
  instance_type          = var.jenkins_instance_type
  subnet_id              = aws_subnet.public[0].id
  vpc_security_group_ids = [aws_security_group.jenkins.id]
  key_name               = aws_key_pair.main.key_name
  iam_instance_profile   = aws_iam_instance_profile.jenkins.name

  root_block_device {
    volume_size = 30
    volume_type = "gp3"
    encrypted   = true
  }
  metadata_options {
    http_tokens                 = "required" # IMDSv2 only
    http_put_response_hop_limit = 2
  }
  tags = { Name = "${var.project}-jenkins", Role = "jenkins" }

  lifecycle {
    ignore_changes = [ami]
  }
}

resource "aws_instance" "app" {
  count                  = var.app_instance_count
  ami                    = data.aws_ami.ubuntu.id
  instance_type          = var.app_instance_type
  subnet_id              = aws_subnet.public[count.index % 2].id # spread across both AZs
  vpc_security_group_ids = [aws_security_group.app.id]
  key_name               = aws_key_pair.main.key_name
  iam_instance_profile   = aws_iam_instance_profile.app.name

  credit_specification {
    cpu_credits = "standard" # no surprise "unlimited" burst charges
  }
  root_block_device {
    volume_size = 12
    volume_type = "gp3"
    encrypted   = true
  }
  metadata_options {
    http_tokens                 = "required"
    http_put_response_hop_limit = 2 # the ECR credential helper runs inside Docker's network namespace
  }
  tags = { Name = "${var.project}-app-${count.index + 1}", Role = "app" }

  lifecycle {
    ignore_changes = [ami]
  }
}
